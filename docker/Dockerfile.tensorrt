
# Stage 1: TensorRT base image.
# The TRT SDK lives in one place only: the NGC TensorRT image, shared with
# neuriplo (which publishes no TRT GHCR package for the same reason — the NGC
# image IS the shared base, so there is nothing to publish and no tarball to
# download). NGC 26.08 bundles Ubuntu 24.04 + CUDA 13.4.1 + TensorRT 11.2.1.2
# (NVIDIA container release notes). Move NGC_CONTAINER_TAG together with
# TENSORRT_VERSION in neuriplo/versions.env.
ARG NGC_CONTAINER_TAG=26.08
FROM nvcr.io/nvidia/tensorrt:${NGC_CONTAINER_TAG}-py3 AS cuda_dependencies

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies with version pinning
RUN apt-get update && apt-get upgrade -y && \
    apt-get install -y \
    cmake=3.* \
    build-essential=12.* \
    libopencv-dev \
    libgoogle-glog-dev \
    wget \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY VERSION /tmp/neuriplo-infer.VERSION
COPY versions.env /tmp/neuriplo-infer.versions.env

RUN dependency_ref=$(awk -F= '/^NEURIPLO_VERSION=/{gsub(/[ \t\r"]/,"",$2); print $2; exit}' /tmp/neuriplo-infer.versions.env) && \
    if [ -z "$dependency_ref" ]; then dependency_ref=develop; \
        if grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' /tmp/neuriplo-infer.VERSION; then dependency_ref=master; fi; fi && \
    wget -q -O /tmp/versions.env "https://raw.githubusercontent.com/olibartfast/neuriplo/${dependency_ref}/versions.env"

# Stage 2: Expose the bundled TensorRT at TENSORRT_DIR
FROM cuda_dependencies AS backend_dependencies

ARG BACKEND=TENSORRT

# The image installs TensorRT into the system paths. cmake and the CI jobs
# (-DTENSORRT_DIR=/opt/tensorrt) expect an include/ + lib/ tree, so point one
# at them, unless the image already provides it. Same layout as neuriplo's
# Dockerfile.tensorrt — the two must stay in sync.
RUN if [ ! -f /opt/tensorrt/include/NvInfer.h ]; then \
        rm -rf /opt/tensorrt && mkdir -p /opt/tensorrt && \
        ln -s /usr/include/x86_64-linux-gnu /opt/tensorrt/include && \
        ln -s /usr/lib/x86_64-linux-gnu /opt/tensorrt/lib; \
    fi && \
    test -f /opt/tensorrt/include/NvInfer.h && \
    test -f /opt/tensorrt/lib/libnvinfer.so && \
    { grep -E "^#define (NV_TENSORRT|TRT)_(MAJOR|MINOR|PATCH|BUILD)" /opt/tensorrt/include/NvInferVersion.h || true; }

# Set TensorRT environment variables (trtexec ships in /usr/src/tensorrt/bin
# on the NGC image; keep TENSORRT_DIR first for the app build).
ENV TENSORRT_DIR=/opt/tensorrt
ENV LD_LIBRARY_PATH=${TENSORRT_DIR}/lib:${LD_LIBRARY_PATH:-}
ENV LIBRARY_PATH=${TENSORRT_DIR}/lib:${LIBRARY_PATH:-}
ENV CPATH=${TENSORRT_DIR}/include
ENV PATH=/usr/src/tensorrt/bin:${TENSORRT_DIR}/bin:${PATH}

# Stage 3: Copy application code and build
FROM backend_dependencies AS builder

ARG BACKEND=TENSORRT

WORKDIR /app

COPY . .

# Build the project using CMake
RUN . /tmp/versions.env && \
    cmake -Bbuild -H. \
    -DDEFAULT_BACKEND=${BACKEND} \
    -DTRT_VERSION=${TENSORRT_VERSION} \
    -DTENSORRT_DIR=${TENSORRT_DIR} \
    -DBUILD_TESTS=OFF && \
    cmake --build build --config Release

# Stage 4: Final image
FROM backend_dependencies AS final

WORKDIR /app

# Copy the executable
COPY --from=builder /app/build/app/neuriplo-infer /app/neuriplo-infer

# Copy the shared libraries
COPY --from=builder /app/build/_deps/neuriplo-build/libneuriplo.so /app/
COPY --from=builder /app/build/_deps/videocapture-build/libVideoCapture.so /app/

# Set the LD_LIBRARY_PATH to include the directory where the `.so` files are located
ENV LD_LIBRARY_PATH=/app:${LD_LIBRARY_PATH}

# Set the entry point to the compiled executable
ENTRYPOINT ["./neuriplo-infer"]
