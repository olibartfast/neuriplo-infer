
# Stage 1: Cuda dependencies
ARG UBUNTU_VERSION=24.04
ARG NGC_CUDA_VERSION=13.0.0
# Prebuilt SDK base override: defaults to the stage below so local builds are
# unchanged; CI passes BASE_IMAGE=ghcr.io/<repo>/tensorrt-deps:<ver>.
ARG BASE_IMAGE=cuda_dependencies
FROM nvcr.io/nvidia/cuda:${NGC_CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION} AS cuda_dependencies

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies with version pinning
RUN apt-get update && apt-get upgrade -y && \
    apt-get install -y \
    cmake=3.* \
    build-essential=12.* \
    libopencv-dev \
    libgoogle-glog-dev \
    wget \
    zstd \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY VERSION /tmp/neuriplo-infer.VERSION
COPY versions.env /tmp/neuriplo-infer.versions.env

RUN dependency_ref=$(awk -F= '/^NEURIPLO_VERSION=/{gsub(/[ \t\r"]/,"",$2); print $2; exit}' /tmp/neuriplo-infer.versions.env) && \
    if [ -z "$dependency_ref" ]; then dependency_ref=develop; \
        if grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' /tmp/neuriplo-infer.VERSION; then dependency_ref=master; fi; fi && \
    wget -q -O /tmp/versions.env "https://raw.githubusercontent.com/olibartfast/neuriplo/${dependency_ref}/versions.env"

# Stage 2: Install TensorRT dependencies (published as tensorrt-deps, see
# .github/workflows/base-images.yml)
FROM ${BASE_IMAGE} AS backend_dependencies

ARG BACKEND=TENSORRT

# Set TensorRT environment variables early so the install check below and
# downstream stages share the same paths.
ENV TENSORRT_DIR=/opt/tensorrt
ENV LD_LIBRARY_PATH=${TENSORRT_DIR}/lib:${LD_LIBRARY_PATH:-}
ENV LIBRARY_PATH=${TENSORRT_DIR}/lib:${LIBRARY_PATH:-}
ENV CPATH=${TENSORRT_DIR}/include
ENV PATH=${TENSORRT_DIR}/bin:${PATH}

COPY VERSION /tmp/neuriplo-infer.VERSION
COPY versions.env /tmp/neuriplo-infer.versions.env

RUN dependency_ref=$(awk -F= '/^NEURIPLO_VERSION=/{gsub(/[ \t\r"]/,"",$2); print $2; exit}' /tmp/neuriplo-infer.versions.env) && \
    if [ -z "$dependency_ref" ]; then dependency_ref=develop; \
        if grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' /tmp/neuriplo-infer.VERSION; then dependency_ref=master; fi; fi && \
    wget -q -O /tmp/versions.env "https://raw.githubusercontent.com/olibartfast/neuriplo/${dependency_ref}/versions.env"

# Download and install TensorRT, unless inheriting a published SDK base that
# already carries this exact pin (checked via the version stamp below).
RUN . /tmp/versions.env && \
    TRT_SHORT=$(echo ${TENSORRT_VERSION} | cut -d. -f1-3) && \
    TRT_CUDA=${TENSORRT_CUDA_VERSION:-$CUDA_VERSION} && \
    STAMP="${TENSORRT_VERSION}-cuda-${TRT_CUDA}" && \
    if [ -d "${TENSORRT_DIR}/lib" ] && [ "$(cat /opt/tensorrt-version.txt 2>/dev/null)" = "$STAMP" ]; then \
        echo "TensorRT $STAMP already installed, skipping download."; \
    else \
        if [ "${TENSORRT_VERSION%%.*}" -ge 11 ]; then \
            archive="TensorRT-Enterprise-${TENSORRT_VERSION}-Linux-x86_64-cuda-${TRT_CUDA}-Release-external.tar.zst"; \
        else \
            archive="TensorRT-${TENSORRT_VERSION}.Linux.x86_64-gnu.cuda-${TRT_CUDA}.tar.gz"; \
        fi && \
        wget --tries=3 --retry-connrefused \
            "https://developer.nvidia.com/downloads/compute/machine-learning/tensorrt/${TRT_SHORT}/tars/${archive}" && \
        tar -xf "$archive" -C /opt && \
        rm "$archive" && \
        ln -sfn /opt/TensorRT-${TENSORRT_VERSION} /opt/tensorrt && \
        echo "$STAMP" > /opt/tensorrt-version.txt; \
    fi

# Fail fast if the SDK or the pin stamp is missing: the skip above must stay
# in sync with the real toolkit layout.
RUN . /tmp/versions.env && \
    TRT_CUDA=${TENSORRT_CUDA_VERSION:-$CUDA_VERSION} && \
    test "$(cat /opt/tensorrt-version.txt)" = "${TENSORRT_VERSION}-cuda-${TRT_CUDA}" && \
    ls "${TENSORRT_DIR}/lib"/libnvinfer.so* >/dev/null

# Stage 3: Copy application code and build
FROM backend_dependencies AS builder

ARG BACKEND=TENSORRT

WORKDIR /app

COPY . .

# Build the project using CMake
RUN . /tmp/versions.env && \
    cmake -Bbuild -H. \
    -DDEFAULT_BACKEND=${BACKEND} \
    -DTRT_VERSION=${TENSORRT_VERSION} \
    -DTENSORRT_DIR=${TENSORRT_DIR} \
    -DBUILD_TESTS=OFF && \
    cmake --build build --config Release

# Stage 4: Final image
FROM backend_dependencies AS final

WORKDIR /app

# Copy the executable
COPY --from=builder /app/build/app/neuriplo-infer /app/neuriplo-infer

# Copy the shared libraries
COPY --from=builder /app/build/_deps/neuriplo-build/libneuriplo.so /app/
COPY --from=builder /app/build/_deps/videocapture-build/libVideoCapture.so /app/

# Set the LD_LIBRARY_PATH to include the directory where the `.so` files are located
ENV LD_LIBRARY_PATH=/app:${LD_LIBRARY_PATH}

# Set the entry point to the compiled executable
ENTRYPOINT ["./neuriplo-infer"]
